<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>Ultimate Habit Tracker</title>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Nunito+Sans:wght@300;400;600&display=swap" rel="stylesheet">
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
:root {
  --green: #3A7D44; --green-light: #C8E6C9; --green-mid: #66BB6A;
  --blue: #1565C0; --blue-light: #BBDEFB; --blue-mid: #42A5F5;
  --yellow: #F9A825; --yellow-light: #FFF9C4; --yellow-mid: #FFD54F;
  --purple: #6A1B9A; --teal: #00695C; --teal-light: #B2DFDB;
  --bg: #F4F6F8; --border: #CFD8DC; --text: #1A1A2E;
  --text-soft: #546E7A; --check-green: #2E7D32; --row-alt: #F8FBF8;
}
body { font-family: 'Nunito Sans', sans-serif; background: var(--bg); color: var(--text); min-height: 100vh; padding-bottom: 40px; }
.top-header { background: linear-gradient(135deg, var(--green) 0%, #2E7D32 100%); color: white; padding: 18px 24px 16px; display: flex; align-items: center; justify-content: space-between; box-shadow: 0 3px 12px rgba(0,0,0,0.18); }
.app-title { font-family: 'Nunito', sans-serif; font-weight: 900; font-size: 1.5rem; letter-spacing: -0.01em; line-height: 1; }
.app-subtitle { font-size: 0.72rem; opacity: 0.8; margin-top: 3px; letter-spacing: 0.06em; text-transform: uppercase; }
.overall-pct-box { text-align: center; background: rgba(255,255,255,0.18); border-radius: 12px; padding: 10px 20px; backdrop-filter: blur(4px); border: 1px solid rgba(255,255,255,0.25); }
.overall-pct-num { font-family: 'Nunito', sans-serif; font-weight: 900; font-size: 2rem; line-height: 1; }
.overall-pct-label { font-size: 0.65rem; opacity: 0.75; letter-spacing: 0.08em; text-transform: uppercase; margin-top: 2px; }
.month-nav { background: white; display: flex; align-items: center; justify-content: space-between; padding: 10px 24px; border-bottom: 2px solid var(--green-light); }
.month-title { font-family: 'Nunito', sans-serif; font-weight: 800; font-size: 1.05rem; color: var(--green); }
.nav-btn { background: var(--green-light); border: none; color: var(--green); font-size: 1rem; font-weight: 700; width: 32px; height: 32px; border-radius: 8px; cursor: pointer; transition: background 0.15s; }
.nav-btn:hover { background: var(--green-mid); color: white; }
.main-wrap { padding: 16px; display: flex; flex-direction: column; gap: 14px; max-width: 1100px; margin: 0 auto; }
.section-card { background: white; border-radius: 14px; overflow: hidden; box-shadow: 0 2px 8px rgba(0,0,0,0.08); border: 1px solid var(--border); }
.section-head { display: flex; align-items: center; justify-content: space-between; padding: 11px 16px; }
.section-head-title { font-family: 'Nunito', sans-serif; font-weight: 900; font-size: 1rem; color: white; letter-spacing: 0.02em; }
.section-pct-badge { background: rgba(255,255,255,0.25); color: white; font-family: 'Nunito', sans-serif; font-weight: 800; font-size: 1.1rem; padding: 2px 14px; border-radius: 20px; border: 1.5px solid rgba(255,255,255,0.4); }
.head-green { background: var(--green); }
.head-blue { background: var(--blue); }
.head-yellow { background: var(--yellow); }
.head-yellow .section-head-title { color: #333; }
.head-yellow .section-pct-badge { color: #333; background: rgba(0,0,0,0.1); border-color: rgba(0,0,0,0.15); }
.head-purple { background: var(--purple); }
.head-teal { background: var(--teal); }
.habits-table { width: 100%; border-collapse: collapse; }
.habits-table th { font-family: 'Nunito', sans-serif; font-weight: 700; font-size: 0.72rem; letter-spacing: 0.06em; text-transform: uppercase; padding: 7px 6px; text-align: center; background: #ECEFF1; color: var(--text-soft); border-bottom: 2px solid var(--border); }
.habits-table th.habit-col { text-align: left; padding-left: 14px; min-width: 160px; }
.habits-table td { padding: 0; border-bottom: 1px solid #ECEFF1; text-align: center; vertical-align: middle; }
.habits-table td.habit-name { text-align: left; padding: 9px 14px; font-size: 0.88rem; font-weight: 600; color: var(--text); white-space: nowrap; }
.habits-table tr:nth-child(even) { background: var(--row-alt); }
.habits-table tr:hover { background: #EDF7ED; }
.check-cell { width: 36px; height: 36px; cursor: pointer; position: relative; }
.check-cell input { display: none; }
.check-box { width: 22px; height: 22px; border: 2px solid #B0BEC5; border-radius: 5px; margin: auto; display: flex; align-items: center; justify-content: center; transition: all 0.15s; background: white; }
.check-cell input:checked + .check-box { background: var(--check-green); border-color: var(--check-green); }
.check-cell input:checked + .check-box::after { content: '✓'; font-size: 0.8rem; font-weight: 900; color: white; }
td.pct-cell { padding: 6px 8px; min-width: 52px; }
.pct-bar-wrap { display: flex; flex-direction: column; align-items: center; gap: 3px; }
.pct-num { font-family: 'Nunito', sans-serif; font-weight: 800; font-size: 0.72rem; color: var(--green); }
.mini-bar { width: 38px; height: 7px; background: #E0E0E0; border-radius: 4px; overflow: hidden; }
.mini-bar-fill { height: 100%; background: var(--green-mid); border-radius: 4px; transition: width 0.3s; }
.daily-done-row td { background: #E8F5E9; font-family: 'Nunito', sans-serif; font-weight: 700; font-size: 0.72rem; color: var(--green); padding: 5px 4px; text-align: center; }
.daily-done-row td.habit-name { color: var(--text-soft); font-size: 0.75rem; text-align: left; }
.daily-done-bar { height: 20px; background: #C8E6C9; border-radius: 4px; overflow: hidden; margin: 2px auto; width: 28px; }
.daily-done-bar-fill { height: 100%; background: var(--green); border-radius: 4px; width: 100%; }
.weekly-done-row td { background: #E3F2FD; font-family: 'Nunito', sans-serif; font-weight: 800; font-size: 0.72rem; color: var(--blue); padding: 5px 4px; text-align: center; }
.weekly-done-row td.habit-name { text-align: left; color: var(--text-soft); }
.goals-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
@media (max-width: 640px) { .goals-grid { grid-template-columns: 1fr; } }
.goal-item { display: flex; align-items: center; gap: 10px; padding: 9px 14px; border-bottom: 1px solid #ECEFF1; cursor: pointer; transition: background 0.12s; }
.goal-item:last-child { border-bottom: none; }
.goal-item:hover { background: #F5F5F5; }
.goal-check { width: 20px; height: 20px; border: 2px solid #B0BEC5; border-radius: 4px; flex-shrink: 0; display: flex; align-items: center; justify-content: center; transition: all 0.15s; font-size: 0.7rem; color: white; background: white; }
.goal-item.done .goal-check { background: var(--blue); border-color: var(--blue); }
.goal-item.done .goal-check::after { content: '✓'; }
.goal-item.done .goal-text { text-decoration: line-through; color: #90A4AE; }
.goal-item.monthly.done .goal-check { background: var(--yellow); border-color: var(--yellow); color: #333; }
.goal-item.week1.done .goal-check { background: var(--purple); border-color: var(--purple); }
.goal-item.week2.done .goal-check { background: var(--teal); border-color: var(--teal); }
.goal-text { font-size: 0.88rem; font-weight: 600; flex: 1; color: var(--text); }
.add-goal-row { display: flex; gap: 8px; padding: 8px 14px; border-top: 1px dashed #CFD8DC; background: #FAFAFA; }
.add-goal-input { flex: 1; border: 1.5px solid #CFD8DC; border-radius: 8px; padding: 7px 10px; font-family: 'Nunito Sans', sans-serif; font-size: 0.85rem; outline: none; color: var(--text); background: white; }
.add-goal-input:focus { border-color: var(--blue); }
.add-goal-btn { background: var(--blue); color: white; border: none; border-radius: 8px; padding: 7px 14px; font-family: 'Nunito', sans-serif; font-weight: 700; font-size: 0.82rem; cursor: pointer; white-space: nowrap; }
.add-goal-btn.yellow { background: var(--yellow); color: #333; }
.add-goal-btn.purple { background: var(--purple); }
.add-goal-btn.teal { background: var(--teal); }
.add-goal-btn.green { background: var(--green); }
.stats-strip { background: white; border-radius: 14px; padding: 14px 18px; display: flex; gap: 10px; flex-wrap: wrap; box-shadow: 0 2px 8px rgba(0,0,0,0.07); border: 1px solid var(--border); }
.stat-pill { flex: 1; min-width: 100px; background: var(--bg); border-radius: 10px; padding: 10px 12px; text-align: center; border: 1px solid var(--border); }
.stat-num { font-family: 'Nunito', sans-serif; font-weight: 900; font-size: 1.5rem; line-height: 1; }
.stat-label { font-size: 0.68rem; color: var(--text-soft); text-transform: uppercase; letter-spacing: 0.07em; margin-top: 3px; }
.stat-pill.green { background: var(--green-light); border-color: var(--green-mid); }
.stat-pill.green .stat-num { color: var(--green); }
.stat-pill.blue { background: var(--blue-light); border-color: var(--blue-mid); }
.stat-pill.blue .stat-num { color: var(--blue); }
.stat-pill.yellow { background: var(--yellow-light); border-color: var(--yellow-mid); }
.stat-pill.yellow .stat-num { color: #E65100; }
.reset-bar { display: flex; gap: 10px; padding: 0 16px; max-width: 1100px; margin: 0 auto; }
.reset-btn { flex: 1; padding: 11px; border: 1.5px solid #CFD8DC; border-radius: 10px; background: white; font-family: 'Nunito', sans-serif; font-weight: 700; font-size: 0.82rem; color: var(--text-soft); cursor: pointer; transition: all 0.15s; }
.reset-btn:hover { background: #FFEBEE; border-color: #EF9A9A; color: #C62828; }
.day-num { font-size: 0.65rem; font-weight: 400; color: #90A4AE; display: block; }
.add-habit-row td { padding: 6px 14px; background: #FAFAFA; border-top: 1px dashed #CFD8DC; }
.add-habit-inner { display: flex; gap: 8px; }
.add-habit-input { flex: 1; border: 1.5px solid #CFD8DC; border-radius: 8px; padding: 6px 10px; font-family: 'Nunito Sans', sans-serif; font-size: 0.85rem; outline: none; color: var(--text); background: white; max-width: 260px; }
.add-habit-input:focus { border-color: var(--green); }
.add-habit-btn { background: var(--green); color: white; border: none; border-radius: 8px; padding: 6px 14px; font-family: 'Nunito', sans-serif; font-weight: 700; font-size: 0.82rem; cursor: pointer; }
</style>
</head>
<body>

<div class="top-header">
  <div>
    <div class="app-title">✨ Ultimate Habit Tracker</div>
    <div class="app-subtitle" id="month-year-sub">May 2026</div>
  </div>
  <div class="overall-pct-box">
    <div class="overall-pct-num" id="overall-pct">0%</div>
    <div class="overall-pct-label">Overall Done</div>
  </div>
</div>

<div class="month-nav">
  <button class="nav-btn" onclick="changeWeek(-1)">◀</button>
  <div class="month-title" id="week-range-label">Week of May 2026</div>
  <button class="nav-btn" onclick="changeWeek(1)">▶</button>
</div>

<div class="main-wrap">
  <div class="stats-strip">
    <div class="stat-pill green"><div class="stat-num" id="stat-habits-done">0</div><div class="stat-label">Habits Done</div></div>
    <div class="stat-pill green"><div class="stat-num" id="stat-streak">0🔥</div><div class="stat-label">Day Streak</div></div>
    <div class="stat-pill blue"><div class="stat-num" id="stat-goals-done">0</div><div class="stat-label">Goals Done</div></div>
    <div class="stat-pill yellow"><div class="stat-num" id="stat-today-pct">0%</div><div class="stat-label">Today's %</div></div>
  </div>

  <div class="section-card">
    <div class="section-head head-green">
      <div class="section-head-title">📋 Daily Habits</div>
      <div class="section-pct-badge" id="habits-overall-pct">0%</div>
    </div>
    <div style="overflow-x:auto">
      <table class="habits-table" id="habits-table">
        <thead><tr id="day-header-row"><th class="habit-col">Habit</th></tr></thead>
        <tbody id="habits-body"></tbody>
      </table>
    </div>
  </div>

  <div class="goals-grid">
    <div class="section-card">
      <div class="section-head head-yellow">
        <div class="section-head-title">🗓 Monthly Goals</div>
        <div class="section-pct-badge" id="monthly-pct">0%</div>
      </div>
      <div id="monthly-goals-list"></div>
      <div class="add-goal-row">
        <input class="add-goal-input" id="monthly-input" placeholder="Add monthly goal…" onkeydown="if(event.key==='Enter') addGoal('monthly')">
        <button class="add-goal-btn yellow" onclick="addGoal('monthly')">+ Add</button>
      </div>
    </div>

    <div class="section-card">
      <div class="section-head head-blue">
        <div class="section-head-title">📅 Weekly Goals</div>
        <div class="section-pct-badge" id="weekly-pct">0%</div>
      </div>
      <div id="weekly-goals-list"></div>
      <div class="add-goal-row">
        <input class="add-goal-input" id="weekly-input" placeholder="Add weekly goal…" onkeydown="if(event.key==='Enter') addGoal('weekly')">
        <button class="add-goal-btn" onclick="addGoal('weekly')">+ Add</button>
      </div>
    </div>

    <div class="section-card">
      <div class="section-head head-purple">
        <div class="section-head-title">⭐ Week 1 Only Goals</div>
        <div class="section-pct-badge" id="week1-pct">0%</div>
      </div>
      <div id="week1-goals-list"></div>
      <div class="add-goal-row">
        <input class="add-goal-input" id="week1-input" placeholder="Add Week 1 goal…" onkeydown="if(event.key==='Enter') addGoal('week1')">
        <button class="add-goal-btn purple" onclick="addGoal('week1')">+ Add</button>
      </div>
    </div>

    <div class="section-card">
      <div class="section-head head-teal">
        <div class="section-head-title">🎯 Week 2 Only Goals</div>
        <div class="section-pct-badge" id="week2-pct">0%</div>
      </div>
      <div id="week2-goals-list"></div>
      <div class="add-goal-row">
        <input class="add-goal-input" id="week2-input" placeholder="Add Week 2 goal…" onkeydown="if(event.key==='Enter') addGoal('week2')">
        <button class="add-goal-btn teal" onclick="addGoal('week2')">+ Add</button>
      </div>
    </div>
  </div>
</div>

<div class="reset-bar">
  <button class="reset-btn" onclick="resetWeek()">🔄 Reset This Week</button>
  <button class="reset-btn" onclick="resetAll()">🗑 Reset Everything</button>
</div>
<br>

<script>
const DAYS = ['Sun','Mon','Tue','Wed','Thu','Fri','Sat'];
const MONTHS = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const today = new Date(); today.setHours(0,0,0,0);
let weekOffset = 0;
let nextId = 1000;

function getWeekStart(offset=0) {
  const d = new Date(today);
  d.setDate(d.getDate() - d.getDay() + offset*7);
  return d;
}
function getWeekDates() {
  const start = getWeekStart(weekOffset);
  return Array.from({length:7},(_,i)=>{ const d=new Date(start); d.setDate(d.getDate()+i); return d; });
}
function dateKey(d) { return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; }
function checkKey(hid,d) { return `${hid}_${dateKey(d)}`; }

let state = JSON.parse(localStorage.getItem('ultimateHabit')||'null') || {
  habits:[
    {id:1,label:'Wake up at 7 am'},
    {id:2,label:'Write in journal every morning'},
    {id:3,label:'Workout for 30 minutes before work'},
    {id:4,label:'Drink at least 70 oz of water'},
    {id:5,label:'Meditate for 15 minutes before bed'},
    {id:6,label:'Read 30 minutes after dinner'},
    {id:7,label:'Take a 45 minute walk'},
    {id:8,label:'Go to sleep by 10pm'},
  ],
  checks:{},
  goals:{
    monthly:[
      {id:'m1',label:'Visit the dentist office',done:false},
      {id:'m2',label:'Read 2 books',done:false},
      {id:'m3',label:'Sign up for a workout class',done:false},
      {id:'m4',label:'Host a dinner party',done:false},
      {id:'m5',label:'Deep clean bathroom',done:false},
    ],
    weekly:[
      {id:'w1',label:"Plan Valentine's Party",done:false},
      {id:'w2',label:'Start new book',done:false},
      {id:'w3',label:'Meal Plan',done:false},
      {id:'w4',label:'Order log review',done:false},
      {id:'w5',label:'Find a new walking route',done:false},
    ],
    week1:[
      {id:'wk1a',label:'Plan back to school event',done:false},
      {id:'wk1b',label:'Pick up supplies',done:false},
      {id:'wk1c',label:'Schedule dentist',done:false},
    ],
    week2:[
      {id:'wk2a',label:'Pay bills',done:false},
      {id:'wk2b',label:'Help with volunteer shift',done:false},
      {id:'wk2c',label:'Finish book chapter',done:false},
    ],
  }
};

function save() { localStorage.setItem('ultimateHabit', JSON.stringify(state)); }

function changeWeek(dir) { weekOffset += dir; renderAll(); }

function renderAll() {
  const dates = getWeekDates();
  const start = dates[0];
  document.getElementById('week-range-label').textContent = `Week of ${MONTHS[start.getMonth()]} ${start.getDate()}, ${start.getFullYear()}`;
  document.getElementById('month-year-sub').textContent = `${MONTHS[today.getMonth()]} ${today.getFullYear()}`;
  renderHabitsTable(dates);
  ['monthly','weekly','week1','week2'].forEach(renderGoals);
  updateStats(dates);
}

function renderHabitsTable(dates) {
  const todayKey = dateKey(today);
  const headerRow = document.getElementById('day-header-row');
  while (headerRow.children.length > 1) headerRow.removeChild(headerRow.lastChild);
  dates.forEach(d => {
    const th = document.createElement('th');
    th.innerHTML = `<span>${DAYS[d.getDay()]}</span><span class="day-num">${d.getDate()}</span>`;
    th.style.minWidth = '40px';
    if (dateKey(d)===todayKey) th.style.background = '#C8E6C9';
    headerRow.appendChild(th);
  });
  ['Daily<br>Done %','Weekly<br>%'].forEach(t => {
    const th = document.createElement('th'); th.innerHTML = t; th.style.minWidth='52px'; headerRow.appendChild(th);
  });

  const tbody = document.getElementById('habits-body');
  tbody.innerHTML = '';

  // Daily done % top row
  const ddr = document.createElement('tr'); ddr.className='daily-done-row';
  const ddl = document.createElement('td'); ddl.className='habit-name'; ddl.textContent='Daily Done %'; ddr.appendChild(ddl);
  dates.forEach(d => {
    const td = document.createElement('td');
    const done = state.habits.filter(h=>state.checks[checkKey(h.id,d)]).length;
    const pct = state.habits.length ? Math.round((done/state.habits.length)*100) : 0;
    const barH = Math.round((pct/100)*20);
    td.innerHTML = `<div style="display:flex;flex-direction:column;align-items:center;gap:2px">
      <div style="font-size:0.7rem;font-weight:800;color:${pct===100?'#2E7D32':'#546E7A'}">${pct}%</div>
      <div class="daily-done-bar"><div class="daily-done-bar-fill" style="height:${barH}px"></div></div></div>`;
    ddr.appendChild(td);
  });
  const emp1=document.createElement('td'); emp1.colSpan=2; ddr.appendChild(emp1);
  tbody.appendChild(ddr);

  // Habit rows
  state.habits.forEach(h => {
    const tr = document.createElement('tr');
    const ntd = document.createElement('td'); ntd.className='habit-name'; ntd.style.cursor='default';
    ntd.innerHTML = `<span>${h.label}</span><button onclick="deleteHabit(${h.id})" style="float:right;background:none;border:none;color:#CFD8DC;cursor:pointer;font-size:0.85rem;padding:0 2px">✕</button>`;
    tr.appendChild(ntd);
    let weekDone=0;
    dates.forEach(d => {
      const td=document.createElement('td'); td.className='check-cell';
      if(dateKey(d)===todayKey) td.style.background='#F1F8F1';
      const key=checkKey(h.id,d); const checked=!!state.checks[key];
      if(checked) weekDone++;
      td.innerHTML=`<label style="width:100%;height:36px;display:flex;align-items:center;justify-content:center;cursor:pointer">
        <input type="checkbox" ${checked?'checked':''} onchange="toggleCheck(${h.id},'${dateKey(d)}',this)">
        <div class="check-box"></div></label>`;
      tr.appendChild(td);
    });
    const wPct=dates.length?Math.round((weekDone/dates.length)*100):0;
    ['var(--green)','var(--blue)'].forEach((col,i) => {
      const td=document.createElement('td'); td.className='pct-cell';
      td.innerHTML=`<div class="pct-bar-wrap"><div class="pct-num" style="color:${col}">${wPct}%</div>
        <div class="mini-bar"><div class="mini-bar-fill" style="width:${wPct}%;background:${i?'var(--blue-mid)':'var(--green-mid)'}"></div></div></div>`;
      tr.appendChild(td);
    });
    tbody.appendChild(tr);
  });

  // Weekly done row
  const wdr=document.createElement('tr'); wdr.className='weekly-done-row';
  const wdl=document.createElement('td'); wdl.className='habit-name'; wdl.textContent='Weekly Done %'; wdr.appendChild(wdl);
  dates.forEach(d => {
    const td=document.createElement('td');
    const done=state.habits.filter(h=>state.checks[checkKey(h.id,d)]).length;
    const pct=state.habits.length?Math.round((done/state.habits.length)*100):0;
    td.textContent=pct+'%'; wdr.appendChild(td);
  });
  const emp2=document.createElement('td'); emp2.colSpan=2; wdr.appendChild(emp2);
  tbody.appendChild(wdr);

  // Add habit row
  const ar=document.createElement('tr'); ar.className='add-habit-row';
  const atd=document.createElement('td'); atd.colSpan=dates.length+3;
  atd.innerHTML=`<div class="add-habit-inner">
    <input class="add-habit-input" id="habit-input" placeholder="Add a new daily habit…" onkeydown="if(event.key==='Enter') addHabit()">
    <button class="add-habit-btn" onclick="addHabit()">+ Add Habit</button></div>`;
  ar.appendChild(atd); tbody.appendChild(ar);

  const weekChecks=state.habits.reduce((acc,h)=>acc+dates.filter(d=>state.checks[checkKey(h.id,d)]).length,0);
  const habitPct=state.habits.length*7?Math.round((weekChecks/(state.habits.length*7))*100):0;
  document.getElementById('habits-overall-pct').textContent=habitPct+'%';
}

function renderGoals(type) {
  const list=document.getElementById(type+'-goals-list'); list.innerHTML='';
  state.goals[type].forEach(g => {
    const div=document.createElement('div');
    div.className=`goal-item ${type} ${g.done?'done':''}`;
    div.innerHTML=`<div class="goal-check"></div><div class="goal-text">${g.label}</div>
      <button onclick="deleteGoal('${type}','${g.id}',event)" style="background:none;border:none;color:#CFD8DC;cursor:pointer;font-size:0.82rem;padding:2px 4px">✕</button>`;
    div.addEventListener('click',()=>toggleGoal(type,g.id));
    list.appendChild(div);
  });
  const done=state.goals[type].filter(g=>g.done).length;
  const pct=state.goals[type].length?Math.round((done/state.goals[type].length)*100):0;
  document.getElementById(type+'-pct').textContent=pct+'%';
}

function updateStats(dates) {
  const weekDone=state.habits.reduce((acc,h)=>acc+dates.filter(d=>state.checks[checkKey(h.id,d)]).length,0);
  const todayDone=state.habits.filter(h=>state.checks[checkKey(h.id,today)]).length;
  const todayPct=state.habits.length?Math.round((todayDone/state.habits.length)*100):0;
  const goalsDone=Object.values(state.goals).flat().filter(g=>g.done).length;
  const goalsTotal=Object.values(state.goals).flat().length;
  const weekPossible=state.habits.length*7;
  const overallPct=weekPossible?Math.round((weekDone/weekPossible)*100):0;
  document.getElementById('stat-habits-done').textContent=weekDone;
  document.getElementById('stat-goals-done').textContent=`${goalsDone}/${goalsTotal}`;
  document.getElementById('stat-today-pct').textContent=todayPct+'%';
  document.getElementById('overall-pct').textContent=overallPct+'%';
  let streak=0, d=new Date(today);
  while(state.habits.some(h=>state.checks[checkKey(h.id,d)])) { streak++; d.setDate(d.getDate()-1); }
  document.getElementById('stat-streak').textContent=streak+'🔥';
}

function toggleCheck(hid,dateStr,el) { state.checks[`${hid}_${dateStr}`]=el.checked; save(); renderAll(); }
function addHabit() { const inp=document.getElementById('habit-input'); const l=inp.value.trim(); if(!l) return; state.habits.push({id:nextId++,label:l}); inp.value=''; save(); renderAll(); }
function deleteHabit(id) { state.habits=state.habits.filter(h=>h.id!==id); save(); renderAll(); }
function addGoal(type) { const inp=document.getElementById(type+'-input'); const l=inp.value.trim(); if(!l) return; state.goals[type].push({id:'g'+nextId++,label:l,done:false}); inp.value=''; save(); renderAll(); }
function toggleGoal(type,id) { const g=state.goals[type].find(x=>x.id===id); if(g) g.done=!g.done; save(); renderAll(); }
function deleteGoal(type,id,e) { e.stopPropagation(); state.goals[type]=state.goals[type].filter(x=>x.id!==id); save(); renderAll(); }
function resetWeek() { if(!confirm('Reset this week?')) return; getWeekDates().forEach(d=>state.habits.forEach(h=>delete state.checks[checkKey(h.id,d)])); save(); renderAll(); }
function resetAll() { if(!confirm('Reset everything?')) return; state.checks={}; Object.values(state.goals).flat().forEach(g=>g.done=false); save(); renderAll(); }

renderAll();
</script>
</body>
